{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEPHIA Native Messaging Protocol v1",
  "description": "Strict in-memory TTS bridge. No caller-supplied text, student data, event ID, or file path.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "action"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "action": {
          "const": "synthesize-approved-announcement"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "ok",
        "format",
        "sampleRate",
        "channels",
        "durationMs",
        "audioBase64"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "ok": {
          "const": true
        },
        "format": {
          "const": "pcm_s16le"
        },
        "sampleRate": {
          "const": 24000
        },
        "channels": {
          "const": 1
        },
        "durationMs": {
          "type": "integer",
          "minimum": 250,
          "maximum": 15000
        },
        "audioBase64": {
          "type": "string",
          "contentEncoding": "base64",
          "maxLength": 955736
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "ok",
        "code"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "ok": {
          "const": false
        },
        "code": {
          "enum": [
            "ENGINE_UNAVAILABLE",
            "BUSY",
            "RATE_LIMITED",
            "INVALID_REQUEST",
            "SYNTHESIS_FAILED",
            "TIMEOUT",
            "OUTPUT_TOO_LARGE"
          ]
        }
      }
    }
  ]
}
